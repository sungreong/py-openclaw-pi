      "checks": [
        {"type": "audit_skill_selected", "value": "naru-git-workflow"},
        {"type": "required_tools_all", "values": ["read", "exec_readonly"]},
        {"type": "forbidden_tools", "values": ["exec", "write", "edit", "multiedit"]},
        {"type": "final_contains", "value": "[GIT-04]"},
        {"type": "final_contains", "value": "[GIT-05]"},
        {"type": "no_tool_errors"}
