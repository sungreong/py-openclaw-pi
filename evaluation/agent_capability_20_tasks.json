      "session": "file-grep",
      "max_model_calls": 5,
      "prompt": "grep 도구로 `{work_rel}/notes` 아래에서 `FEATURE_ALPHA`를 찾아 값과 발견된 파일 경로를 모두 알려주세요.",
      "checks": [
        {"type": "required_tools_all", "values": ["grep"]},
        {"type": "final_contains", "value": "enabled"},
        {"type": "final_contains", "value": "feature.txt"},
        {"type": "no_tool_errors"}
      ]
    },
