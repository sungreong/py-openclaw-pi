      "level": 1,
      "title": "정확한 파일 질의",
      "capability": "지정 파일 읽기와 근거 답변",
      "session": "file-read",
      "max_model_calls": 4,
      "prompt": "`{work_rel}/brief.md` 파일을 read 도구로 읽고 프로젝트 코드명만 답하세요.",
      "checks": [
        {"type": "required_tools_all", "values": ["read"]},
        {"type": "final_contains", "value": "ORBIT-42"},
        {"type": "no_tool_errors"}
