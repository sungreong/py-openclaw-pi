{
  "schema_version": 1,
  "title": "PiAgent 20-task capability evaluation",
  "tasks": [
    {
      "id": "T01",
      "level": 1,
      "title": "기초 산술",
      "capability": "도구 없는 정확한 계산",
      "session": "basic-math",
      "max_model_calls": 2,
      "prompt": "도구를 사용하지 말고 계산하세요. (17 × 23) + 5의 값을 구한 뒤 최종 답변을 정확히 '정답: <숫자>' 한 줄로 작성하세요.",
      "checks": [
        {"type": "final_contains", "value": "정답: 396"},
        {"type": "tool_count_max", "value": 0},
        {"type": "no_tool_errors"}
      ]
    },
    {
      "id": "T02",
      "level": 1,
      "title": "구조화 정렬",
      "capability": "간단한 구조화 출력",
      "session": "basic-structure",
      "max_model_calls": 2,
      "prompt": "도구 없이 다음 항목을 priority 오름차순으로 정렬하세요: A=2, B=1, C=3. 각 줄을 '<id>:<priority>' 형식으로 쓰고 설명은 추가하지 마세요.",
      "checks": [
        {"type": "final_order", "values": ["B:1", "A:2", "C:3"]},
        {"type": "tool_count_max", "value": 0},
        {"type": "no_tool_errors"}
      ]
    },
    {
      "id": "T03",
      "level": 1,
      "title": "디렉터리 탐색",
      "capability": "워크스페이스 목록 도구",
      "session": "file-list",
      "max_model_calls": 4,
      "prompt": "`{work_rel}` 디렉터리를 ls 도구로 확인하고, 그 안에 있는 항목 이름을 짧게 알려주세요. 추측하지 마세요.",
      "checks": [
        {"type": "required_tools_all", "values": ["ls"]},
        {"type": "final_contains", "value": "brief.md"},
        {"type": "no_tool_errors"}
      ]
    },
