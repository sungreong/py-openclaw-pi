      "level": 2,
      "title": "동일 세션 재시작 회상",
      "capability": "새 Agent 인스턴스의 세션 복원",
      "session": "shared-session",
      "depends_on": ["T09"],
      "max_model_calls": 3,
      "prompt": "앞선 대화에서 정한 프로젝트 코드명은 무엇인가요? 코드명만 답하세요.",
      "checks": [
        {"type": "final_contains", "value": "NEBULA-731"},
        {"type": "no_tool_errors"}
      ]
