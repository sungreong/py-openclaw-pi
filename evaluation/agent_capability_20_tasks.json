        {"type": "required_tools_all", "values": ["memory_search", "memory_get", "session_fragment_search", "session_fragment_get", "write", "word_report_create", "ls"]},
        {"type": "artifact_text_contains", "path": "{work_rel}/outputs/capstone.md", "values": ["RED", "제한"]},
        {"type": "artifact_docx", "path": "{work_rel}/outputs/capstone.docx", "min_bytes": 1000},
        {"type": "no_tool_errors"}
      ]
