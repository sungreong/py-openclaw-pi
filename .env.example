# Configure one model route. Keep real keys only in .env.
# Route A: OpenAI
OPENAI_API_KEY=

# Route B: Local Bedrock OpenAI-compatible API
# When all three values are set, this route takes precedence over OPENAI_API_KEY.
# LOCAL_BEDROCK_BASE_URL=https://bedrock-runtime.ap-northeast-1.amazonaws.com
# LOCAL_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# LOCAL_BEDROCK_API_KEY=

# Core runtime
PI_MODEL=gpt-4o-mini
PI_WORKSPACE=.
PI_SESSION=main
PI_SESSION_DIR=.openclaw_pi/sessions
PI_AUDIT_DIR=.openclaw_pi/audit

# Limits
PI_MAX_MODEL_CALLS=16
PI_EXEC_TIMEOUT=60

# Tool toggles (true/false)
PI_NO_WRITE=false
PI_NO_SHELL=false
PI_NO_COMPACTION=false
PI_NO_MEMORY=false

# Workspace-scoped Python package installation (disabled by default)
PI_ALLOW_PACKAGE_INSTALL=false
# Prefer exact pins. The agent cannot install packages outside this list.
PI_PACKAGE_INSTALL_ALLOWLIST=python-docx==1.2.0,matplotlib==3.11.1,pandas==3.0.5,yfinance==1.6.0
PI_PACKAGE_INSTALL_TIMEOUT=180

# Trusted workspace extensions under .piagent/ (disabled by default)
PI_WORKSPACE_EXTENSIONS_ENABLED=false
PI_WORKSPACE_EXTENSION_DIR=.piagent

# Memory
PI_MEMORY_MODE=openclaw
PI_MEMORY_DIR=.openclaw/memory
PI_MEMORY_LIMIT=200
PI_MEMORY_RECALL_LIMIT=5
PI_MEMORY_SEARCH_BACKEND=sqlite-vec
PI_MEMORY_EMBEDDING_PROVIDER=auto
PI_MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Read strategy
# smart: large files -> metadata + head/tail preview (default)
# legacy: full-read behavior
PI_READ_STRATEGY=smart

# Exec behavior
PI_EXEC_PATH_CORRECTION=false

# Optional tool filters (comma-separated)
# PI_ALLOW_TOOL=read,edit,grep,exec
# PI_DENY_TOOL=exec

# Blocked paths policy (comma-separated)
PI_BLOCKED_PATHS=.env,.git/**,.openclaw/memory/**,secrets/**,private/**,node_modules/**
