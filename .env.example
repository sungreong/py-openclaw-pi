# Required
OPENAI_API_KEY=your_openai_api_key_here

# Core runtime
PI_MODEL=gpt-4o-mini
PI_WORKSPACE=.
PI_SESSION=main
PI_SESSION_DIR=.openclaw_pi/sessions
PI_AUDIT_DIR=.openclaw_pi/audit

# Limits
PI_MAX_MODEL_CALLS=16
PI_EXEC_TIMEOUT=60

# Tool toggles (true/false)
PI_NO_WRITE=false
PI_NO_SHELL=false
PI_NO_COMPACTION=false
PI_NO_MEMORY=false

# Memory
PI_MEMORY_MODE=openclaw
PI_MEMORY_DIR=.openclaw/memory
PI_MEMORY_LIMIT=200
PI_MEMORY_RECALL_LIMIT=5
PI_MEMORY_SEARCH_BACKEND=sqlite-vec
PI_MEMORY_EMBEDDING_PROVIDER=auto
PI_MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Read strategy
# smart: large files -> metadata + head/tail preview (default)
# legacy: full-read behavior
PI_READ_STRATEGY=smart

# Exec behavior
PI_EXEC_PATH_CORRECTION=false

# Optional tool filters (comma-separated)
# PI_ALLOW_TOOL=read,edit,grep,exec
# PI_DENY_TOOL=exec

# Blocked paths policy (comma-separated)
PI_BLOCKED_PATHS=.env,.git/**,.openclaw/memory/**,secrets/**,private/**,node_modules/**
